<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions. Merged into the main manifest for debug builds and absent from release,
  so nothing declared here can ship: no extra launcher icon, no developer surface in production.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Gallery host for the Gridlink UI work (docs/GRIDLINK-UI-BRIEF.md). Its own launcher entry
          so the screens can be opened directly, without navigating the real app to reach a
          half-built screen.
        -->
        <!--
          🔴 Required for the thread view's back gesture to report progress. Without it the system
          runs the legacy path on API 33+: PredictiveBackHandler still fires, but only once and
          only at commit, so the thread snaps shut instead of following the finger, and nothing
          logs a warning to say why.

          The main manifest now sets this on <application> too (audited 2026-08-08: every back
          consumer in the app is an androidx BackHandler/PredictiveBackHandler or a Dialog window,
          nothing overrides onBackPressed or watches KEYCODE_BACK). Kept here as well so the
          gallery keeps working if the app-wide flag is ever pulled back.
        -->
        <!--
          🔴 adjustResize, matching the real MainActivity. The gallery calls enableEdgeToEdge(), and
          the default (adjustPan) shoves the whole window up by the keyboard's height instead of
          reporting an inset: the composer's own WindowInsets.ime padding then measures against a
          window that has already moved, and the header slides off the top while the body field
          still ends up under the keys. Resize hands the keyboard's height to the layout as an
          inset, which is what every field on these screens is written to consume.
        -->
        <activity
            android:name="app.gridlink.gallery.GridlinkGalleryActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="Gridlink UI"
            android:theme="@style/Theme.Gridlink"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The home-screen widgets, drawn from the sample calendar. No launcher entry: this is a
          harness for one layout, not a second app, and it is reached by name from adb.

          The widget card draws its own background, so it takes the plain app theme rather than
          Theme.Gridlink's edge-to-edge chrome: a widget is never edge to edge on a home screen,
          and framing it as though it were is a picture of something the launcher will not show.
        -->
        <activity
            android:name="app.gridlink.gallery.GridlinkWidgetGalleryActivity"
            android:exported="true"
            android:label="Gridlink widgets"
            android:theme="@style/Theme.Gridlink" />
    </application>
</manifest>
