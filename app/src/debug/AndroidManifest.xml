<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions. Merged into the main manifest for debug builds and absent from release,
  so nothing declared here can ship: no extra launcher icon, no developer surface in production.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          Gallery host for the Gridlink UI work (docs/GRIDLINK-UI-BRIEF.md). Its own launcher entry
          so the screens can be opened directly, without navigating the real app to reach a
          half-built screen.
        -->
        <!--
          🔴 Required for the thread view's back gesture to report progress. Without it the system
          runs the legacy path on API 33+: PredictiveBackHandler still fires, but only once and
          only at commit, so the thread snaps shut instead of following the finger, and nothing
          logs a warning to say why.

          Set per-activity rather than on <application>, deliberately. This is a fork, the flag is
          an app-wide behaviour change, and upstream Sterna's MainActivity has not been audited for
          it. Scoped here it cannot affect anything but the gallery, and it cannot ship at all.
        -->
        <activity
            android:name="app.sterna.gridlink.GridlinkGalleryActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="Gridlink UI"
            android:theme="@style/Theme.Sterna">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
