<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Watch the default network so the inbox resyncs when connectivity returns (#65).
         Already merged in from WorkManager; declared here because the app itself uses it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: recipient autocomplete from device contacts (off by default; opt-in in Settings). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Optional: publishing the account's CardDAV/CalDAV cache into the system's own contacts and
         calendar, so caller ID and the Calendar app see it (off by default; opt-in in Settings).
         All four are asked for together and only when that switch is turned on — a sync adapter
         runs with no Activity to attach a prompt to, so it can only check, never ask. READ is not
         redundant beside WRITE: the mirror reconciles, so each pass has to read back what it wrote
         last time to know what changed and what the server has since deleted. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Normal permissions (granted at install): let the app mark its own account's providers
         syncable and ask the system to run a sync when the user turns the switch on. -->
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Normal permission (granted at install, nothing asked of the user): lets the app hear
         about a finished boot so the push connection comes back without opening the app (#98). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Package visibility (Android 11+): let Gridlink see and bind the OpenKeychain
         OpenPGP provider for message encryption/signing. -->
    <queries>
        <package android:name="org.sufficientlysecure.keychain" />
        <package android:name="org.sufficientlysecure.keychain.debug" />
        <intent>
            <action android:name="org.openintents.openpgp.IOpenPgpService2" />
        </intent>
    </queries>

    <application
        android:name=".GridlinkApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Gridlink">

        <!-- singleTask: a mailto: tap while the app runs re-enters the existing instance via
             onNewIntent instead of stacking a second MainActivity (and a second inbox). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="${appLabel}"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Gridlink.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- mailto: links (Codeberg #15) — from browsers/webviews (VIEW+BROWSABLE) and from
                 apps dispatching a compose action (SENDTO). Registers Gridlink as an email app in
                 the system's open-with choices. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mailto" />
            </intent-filter>
            <!-- System "Share" target (Codeberg #45): shared text/links prefill the body, shared
                 files are attached. text/plain plus */* so anything can be emailed. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- specialUse (not dataSync): Android 15+ budgets dataSync FGS and then blocks
             background restarts, which silently killed push on newer devices (#11). The
             persistent user-initiated email-push connection is the canonical specialUse
             case (no Google/FCM alternative exists for self-hosted JMAP/IMAP servers). -->
        <service
            android:name=".push.PushService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Realtime new-mail push over the user's own mail-server connections (JMAP EventSource / IMAP IDLE); no FCM/Google alternative exists for self-hosted servers." />
        </service>

        <!-- UnifiedPush events from the distributor (issue #17): endpoint updates,
             PushVerification and StateChange payloads. The connector decrypts WebPush
             before delivery. Inert unless a distributor app is installed. -->
        <service
            android:name=".push.UnifiedPushReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- Lets AppCompat persist the in-app language choice on Android 12 and below
             (on Android 13+ the platform stores it). See AppCompatDelegate.setApplicationLocales. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <receiver
            android:name=".push.NotificationActionReceiver"
            android:exported="false" />

        <!-- Restarts the direct push connection after a reboot or an in-place app update
             (issue #98); does nothing when UnifiedPush, battery-saver delivery or no account
             at all means there is no connection of ours to hold. Exported because a manifest
             receiver that is not exported never sees a system broadcast; both actions are
             protected broadcasts, so no other app can trigger it. -->
        <receiver
            android:name=".push.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widgets.

             Exported, and all three have to be: a widget provider is a receiver the LAUNCHER
             sends APPWIDGET_UPDATE to, and an un-exported one is simply never woken — the same
             reason BootReceiver above is exported. The actions it answers are all system
             broadcasts except REFRESH, which only redraws from the local cache and asks the
             existing fetch worker to run; there is nothing there for another app to gain by
             sending it. -->
        <receiver
            android:name=".widget.InboxWidgetProvider"
            android:exported="true"
            android:label="@string/widget_inbox_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.gridlink.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_inbox_info" />
        </receiver>

        <receiver
            android:name=".widget.UnreadWidgetProvider"
            android:exported="true"
            android:label="@string/widget_unread_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unread_info" />
        </receiver>

        <receiver
            android:name=".widget.AgendaWidgetProvider"
            android:exported="true"
            android:label="@string/widget_agenda_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.gridlink.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_info" />
        </receiver>

        <!-- Supplies the list widget's rows. BIND_REMOTEVIEWS is held by the system alone, so
             only the launcher can bind this; without it any app could pull the rows, which are
             senders, subjects and previews of the user's mail. -->
        <service
            android:name=".widget.InboxWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- The agenda widget's rows, guarded the same way and for the same reason: these are the
             titles, times and locations of the user's appointments. -->
        <service
            android:name=".widget.AgendaWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- The system contacts/calendar mirror (Phase 3 #4). All three services are exported
             because the system binds them from another process, and none of them carries an
             android:permission — the framework binds them as itself, and a permission the binder
             does not hold is a mirror that silently never runs. Nothing is exposed by that: the
             authenticator issues no tokens and holds no credential (see GridlinkAuthenticator), and
             a sync adapter's binder only lets a caller ask the sync framework to schedule a run. -->
        <service
            android:name=".sync.GridlinkAuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

        <service
            android:name=".sync.ContactsSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/contacts_syncadapter" />
        </service>

        <service
            android:name=".sync.CalendarSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/calendar_syncadapter" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
