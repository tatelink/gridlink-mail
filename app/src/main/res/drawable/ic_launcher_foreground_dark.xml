<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The Gridlink mark, dark mode. Ported from `export/gridlink-dark.svg` in the icon pack
         Tate shipped (its README calls the variant "11a - Hot node"), which is the authored
         source for the Windows .ico, iOS, the favicons and the PWA tiles as well. That pack is the
         master: if the mark changes, it changes there and gets re-ported here, never edited here.

         ## The mark
         Four rounded rects on a faint grid, deliberately NOT four equal cells. A big quiet block
         top-left, two narrow inert blocks down the other two sides, and one small bright node
         bottom-right with light pouring off it. The size difference is the whole idea: the eye is
         meant to land on the smallest thing on the icon because it is the only lit one. Four equal
         cells (which an earlier version of this file had) throws that away and leaves a window pane.

         ## The 512 -> 108 transform: android = svg/8 + 22
         The master is a 512 tile with the mark inset to 64..448. An adaptive icon's 108 viewport
         only ever shows the middle 72, so the master tile maps onto that 72, and the divide-by-8
         falls out of it: every coordinate in the master is a multiple of 8, so nothing lands on an
         awkward fraction. The mark ends up spanning 30..78, a 48-unit box, 67% of what is seen.

         🔴 Do not scale it up to "fill" more of the 108. The margin is not waste, it is the mask's
         clearance. At 48 the mark's furthest corner sits 31 units from centre, inside the 33-unit
         circle Android guarantees no mask will clip. Take the mark to the master's own 75% and that
         corner reaches 34.9, which survives a squircle and gets shaved by a circle.

         🔴 The master's rx=112 tile rounding is dropped on purpose. The launcher's mask does the
         rounding here, and a pre-rounded tile inside a mask reads as a sticker of an icon.

         ## What could not be ported exactly
         `feGaussianBlur` has no VectorDrawable equivalent, so the bloom under the hot node is a
         radial gradient. Its reach is matched rather than guessed: the master's blur carries to
         about svg 500, which is 84.5 here, so the radius is 14.5 from the node's centre at (70,70).

         The bloom sits in the FOREGROUND with the node, not in the background layer. Launchers
         parallax the two layers against each other, and a glow that slides off the thing casting it
         is worse than no glow at all. -->

    <!-- The grid. 6% alpha and a quarter-unit stroke, so it is texture rather than a feature and at
         launcher sizes it is felt more than seen. Kept anyway: it is the "grid" in Gridlink, and it
         does show at the larger sizes the system uses in Settings and app info. -->
    <path
        android:strokeColor="#4C9AF5"
        android:strokeWidth="0.25"
        android:strokeAlpha="0.06"
        android:pathData="M38,30V78 M46,30V78 M54,30V78 M62,30V78 M70,30V78
            M30,38H78 M30,46H78 M30,54H78 M30,62H78 M30,70H78" />

    <!-- Bloom under the hot node. Drawn before the rects so the node sits in it, not under it. -->
    <path android:pathData="M55.5,55.5h29v29h-29z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="70"
                android:centerY="70"
                android:gradientRadius="14.5">
                <item android:offset="0" android:color="#D9AEE0FF" />
                <item android:offset="0.55" android:color="#B3AEE0FF" />
                <item android:offset="0.8" android:color="#4DAEE0FF" />
                <item android:offset="1" android:color="#00AEE0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-left block: the mass. Mid-blue, gradient top to bottom. -->
    <path
        android:strokeColor="#7FB6F2"
        android:strokeWidth="0.3125"
        android:strokeAlpha="0.35"
        android:pathData="M37,30
            h15 a7,7 0 0 1 7,7
            v15 a7,7 0 0 1 -7,7
            h-15 a7,7 0 0 1 -7,-7
            v-15 a7,7 0 0 1 7,-7 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="44.5" android:startY="30"
                android:endX="44.5" android:endY="59">
                <item android:offset="0" android:color="#FF3D77C2" />
                <item android:offset="1" android:color="#FF24548F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-right block: inert. The same near-black navy in both themes, which is why the light
         variant does not simply invert: see the note in ../drawable/ic_launcher_foreground.xml. -->
    <path
        android:fillColor="#FF12233C"
        android:strokeColor="#4C9AF5"
        android:strokeWidth="0.3125"
        android:strokeAlpha="0.25"
        android:pathData="M67,30
            h6 a5,5 0 0 1 5,5
            v19 a5,5 0 0 1 -5,5
            h-6 a5,5 0 0 1 -5,-5
            v-19 a5,5 0 0 1 5,-5 z" />

    <!-- Bottom-left block: inert. -->
    <path
        android:fillColor="#FF12233C"
        android:strokeColor="#4C9AF5"
        android:strokeWidth="0.3125"
        android:strokeAlpha="0.25"
        android:pathData="M35,62
            h19 a5,5 0 0 1 5,5
            v6 a5,5 0 0 1 -5,5
            h-19 a5,5 0 0 1 -5,-5
            v-6 a5,5 0 0 1 5,-5 z" />

    <!-- The hot node. White into pale blue: on a near-black tile the lit thing goes all the way to
         white, which is what makes it read as emitting rather than as a brighter blue. -->
    <path
        android:pathData="M67,62
            h6 a5,5 0 0 1 5,5
            v6 a5,5 0 0 1 -5,5
            h-6 a5,5 0 0 1 -5,-5
            v-6 a5,5 0 0 1 5,-5 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="70" android:startY="62"
                android:endX="70" android:endY="78">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FFBFE4FA" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
