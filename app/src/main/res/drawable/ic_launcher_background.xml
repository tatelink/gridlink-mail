<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The Gridlink tile, light mode: `<rect fill="#E9EFF7">` from `export/gridlink-light.svg`.

         Flat, and an earlier version of this file was not. That one predates Tate's light
         artwork and carried a shallow cool gradient on the theory that near-white on a light
         launcher drawer has no edge of its own and would read as a floating mark rather than a
         tile. The real design answers that differently and better: it keeps the tile flat and puts
         two near-black blocks in the mark, which give the icon all the edge it needs from the
         inside. Flat wins, and it matches every other surface Gridlink ships on.

         Full bleed with no corner rounding: the launcher's mask does that. -->
    <path
        android:fillColor="#FFE9EFF7"
        android:pathData="M0,0h108v108h-108z" />
</vector>
