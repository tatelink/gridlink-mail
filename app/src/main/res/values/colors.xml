<resources>
    <!-- Pre-Compose window background, matching the Arctic (light) surface so launch
         shows the brand colour instead of a white flash. Compose drives all in-app colour. -->
    <color name="gridlink_window_background">#F7F8FA</color>
    <!-- Splash field. This is the Gridlink icon's own tile colour, not a near-match: the
         cold start draws the launcher mark on it, so an exact match reads as the icon
         growing into the app rather than as a second screen. Follows day/night (an
         always-light splash is a flashbang on a dark-themed device). -->
    <color name="gridlink_splash_background">#E9EFF7</color>
</resources>
