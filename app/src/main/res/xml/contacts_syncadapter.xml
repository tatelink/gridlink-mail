<?xml version="1.0" encoding="utf-8"?>
<!--
  supportsUploading="true" is what makes the system Contacts app offer these contacts for editing
  (and offer this account for new ones), and what raises a sync when one changes, so the edit is
  sent to the server. The fields it may edit are declared in contacts.xml.
-->
<sync-adapter xmlns:android="http://schemas.android.com/apk/res/android"
    android:contentAuthority="com.android.contacts"
    android:accountType="@string/gridlink_account_type"
    android:supportsUploading="true"
    android:userVisible="true"
    android:isAlwaysSyncable="true" />
