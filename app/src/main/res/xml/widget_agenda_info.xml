<?xml version="1.0" encoding="utf-8"?>
<!--
  The resizable agenda widget.

  🔴 updatePeriodMillis is 30 minutes for the same reason the mail widget's is: that is the floor
  the platform honours, and a smaller number is silently rounded up rather than refused. It matters
  more here than there. An agenda's rows go stale by the clock rather than by an event arriving, so
  this timer IS most of the refresh, and the poke from a calendar sync is the exception.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_agenda"
    android:previewLayout="@layout/widget_agenda"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_agenda_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
