# Forgejo runner config for docker-compose.yml.
#
# Usage on the server:
#   cp .env.example .env
#   # paste your token below, then:
#   docker compose up -d
#
# Get the token from Codeberg:
#   the `jmail` repo -> Settings -> Actions -> Runners -> "Create new runner".
# The real .env is gitignored — never commit the token.

RUNNER_TOKEN=
